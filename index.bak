// Подключение библиотек (если у темы нет enqueue — подключаем явно здесь)
// Если у тебя уже загружены эти скрипты глобально — можно убрать эти теги.
?>
<script src="<?php echo esc_url( get_template_directory_uri() ); ?>/js/three.min.js"></script>
<script src="<?php echo esc_url( get_template_directory_uri() ); ?>/js/gsap.min.js"></script>

<script>
(function(){
  // Контент-видео: укажи свои файлы
  const videos = [
    "https://walkingyog.com/wp-content/uploads/2025/11/11282-1.mp4",
    "https://walkingyog.com/wp-content/uploads/2025/11/30Сек43-1.mp4",
    "https://walkingyog.com/wp-content/uploads/2025/12/1203-9166.mp4",
    "https://walkingyog.com/wp-content/uploads/2025/11/11271-1.mp4",
    "https://walkingyog.com/wp-content/uploads/2025/12/12071.mp4"
    
  ];

  // --- Сцена Three.js ---
  const canvas = document.getElementById('dissolve-canvas');
  // guard
  if(!canvas) return;

  let renderer = new THREE.WebGLRenderer({canvas: canvas, alpha: true, antialias: true});
  function setRendererSize(){
    const rect = canvas.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    renderer.setPixelRatio(dpr);
    renderer.setSize(rect.width, rect.height, false);
  }
  setRendererSize();
  window.addEventListener('resize', setRendererSize);

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(45, canvas.clientWidth / canvas.clientHeight, 0.1, 1000);
  camera.position.z = 150;

  // Геометрия: снизил сегменты для производительности
  const segX = 40, segY = 70;
 const geo = new THREE.PlaneGeometry(80, 125, segX, segY);
  const mat = new THREE.MeshBasicMaterial({transparent:true, opacity: 1, side: THREE.DoubleSide});
  const plane = new THREE.Mesh(geo, mat);
  scene.add(plane);

  // Сохранение оригинальных позиций для анимации
  const positionAttr = geo.attributes.position;
  const origPositions = new Float32Array(positionAttr.count * 3);
  for(let i=0;i<positionAttr.array.length;i++) origPositions[i] = positionAttr.array[i];

  // Video handling
  let videoEl = document.createElement('video');
  videoEl.muted = true;
  videoEl.playsInline = true;
  videoEl.crossOrigin = "anonymous";
  videoEl.loop = true;
  videoEl.style.display = 'none';
  document.body.appendChild(videoEl);

  let videoTexture = null;
  let currentIndex = 0;

  function setVideoSource(index){
    if(!videos[index]) return;
    // set src and load
    videoEl.pause();
    videoEl.src = videos[index];
    videoEl.load();
    videoEl.oncanplay = function(){
      try{
        videoEl.play().catch(()=>{ /* autoplay may be blocked */ });
      }catch(e){}
      // recreate texture
      if(videoTexture) { videoTexture.dispose && videoTexture.dispose(); }
      videoTexture = new THREE.VideoTexture(videoEl);
      videoTexture.minFilter = THREE.LinearFilter;
      videoTexture.magFilter = THREE.LinearFilter;
      videoTexture.format = THREE.RGBFormat;
      mat.map = videoTexture;
      mat.needsUpdate = true;
      currentIndex = index;
    };
  }

  // Запуск первого видео (лениво)
  setVideoSource(0);

  // --- Dissolve animation via lerp between origPositions and random offset ---
  function createOffsetArray(amplitude){
    const offsets = new Float32Array(origPositions.length);
    for(let i=0;i<offsets.length;i++){
      // random offset, reduce amplitude near center (smooth)
      offsets[i] = (Math.random() - 0.5) * amplitude;
    }
    return offsets;
  }

  function animateDissolve(duration = 2.4, amplitude = 80, fadeDelay = 1.6){
    // prepare offsets and animate t from 0..1
    const offsets = createOffsetArray(amplitude);
    const state = { t: 0 };
    // fade out opacity a bit delayed
    gsap.to(mat, { opacity: 0, delay: fadeDelay, duration: 1.6, ease: "power2.out" });

    gsap.to(state, {
      t: 1,
      duration: duration,
      ease: "power4.out",
      onUpdate: function(){
        const t = state.t;
        // linear interpolation orig -> orig+offsets
        const pos = positionAttr.array;
        for(let i=0;i<pos.length;i++){
          pos[i] = origPositions[i] + offsets[i] * t;
        }
        positionAttr.needsUpdate = true;
      },
      onComplete: function(){
        // restore positions back smoothly and reset opacity, then switch video
        gsap.to(mat, { opacity: 1, duration: 0.8, ease: "power2.inOut" });
        // restore geometry to original positions smoothly
        const restore = { r: 0 };
        gsap.to(restore, {
          r: 1,
          duration: 0.9,
          ease: "power2.inOut",
          onUpdate: function(){
            const r = restore.r;
            const pos = positionAttr.array;
            for(let i=0;i<pos.length;i++){
              pos[i] = origPositions[i] + (offsets[i] * (1 - r));
            }
            positionAttr.needsUpdate = true;
          },
          onComplete: function(){
            // after complete — change to next video
            const next = (currentIndex + 1) % videos.length;
            setVideoSource(next);
          }
        });
      }
    });
  }

  // loop rendering
  (function renderLoop(){
    requestAnimationFrame(renderLoop);
    renderer.render(scene, camera);
    if(videoTexture) videoTexture.needsUpdate = true;
  })();

  // scheduling dissolves
  let dissolveTimer = null;
  function scheduleDissolve(){
    // first dissolve at ~12s, then spaced
    setTimeout(function(){
      animateDissolve();
      dissolveTimer = setInterval(function(){
        animateDissolve();
      }, 45000 + Math.random() * 20000);
    }, 12000);
  }
  scheduleDissolve();

  // expose for debugging / manual next
  window.wy_next_dissolve = animateDissolve;
  window.wy_set_video = setVideoSource;

  // --- Trailer button logic: show native <video> element (controls) and play ---
  window.showTrailer = function(){
    const trailer = document.getElementById('trailer');
    if(!trailer) return;
    trailer.style.display = 'block';
    trailer.play().catch(()=>{ /* maybe blocked on mobile */ });
    // scroll to it
    trailer.scrollIntoView({behavior:'smooth',block:'center'});
  };

})();
</script>

<div class="site-content container">
  <div class="panel text-center">
    <div class="cover" role="img" aria-label="WalkingYog logo"></div>

    <h1 style="font-size:2.2rem;color:#0ff;margin:8px 0 2px;">
      ओं मणिपद्मे हूं<br>Om Mani Padme HUM
    </h1>
    <h2 style="margin:0 0 10px;color:#9aa">Держи баланс —  by ShamanOrWitch</h2>

    <div class="links">
      <button class="link" onclick="showTrailer()">🎬 Смотреть трейлер (30 MB)</button>
     
      <a class="link" href="https://open.spotify.com/artist/3AhCSHtdfK8fmTBqGXAts1" target="_blank" rel="noopener">🎧 Spotify</a>
       <a class="link" href="https://soundcloud.com/jah-shaman" target="_blank" rel="noopener">🌊 SoundCloud</a>
      <a class="link" href="https://www.deezer.com/en/profile/6655306301" target="_blank" rel="noopener">🎶 Deezer</a>
      <a class="link" href="https://open.anghami.com/rEj690dgfXb" target="_blank" rel="noopener">🎵 Anghami</a>
      <a class="link" href="https://music.apple.com/il/artist/shamanorwitch/1838926179" target="_blank" rel="noopener"> "A" apple</a>
      <a class="link" href="https://music.youtube.com/playlist?list=PLdZQQfOk25DkP-m5sFXU-U6u_S3zIyI0w" target="_blank" rel="noopener">🔴 youtube music</a>
      
      <a class="link" href="https://www.youtube.com/@WalkingYog" target="_blank" rel="noopener">▶️ YouTube</a>
      
      <a class="link" href="https://vk.com/jahshaman" target="_blank" rel="noopener">📀 VK</a>
      <a class="link" href="https://www.instagram.com/walkingyog/" target="_blank" rel="noopener">📸 Instagram</a>
      <a class="link" href="https://www.twitch.tv/walkingyog" target="_blank" rel="noopener">👾 Twich</a>
            <a class="link" href="https://www.tiktok.com/@walking_yog" target="_blank" rel="noopener">🎬 TikTok</a>
      <a class="link" href="https://x.com/walkingyog" target="_blank" rel="noopener">🐦 X (Twitter)</a>
      <a class="link" href="https://www.facebook.com/YogWalking" target="_blank" rel="noopener">📘 Facebook</a>
      <a class="link" href="https://walkingyog.com" target="_blank" rel="noopener">🌐 Official Website</a>
    </div>

    <video id="trailer" controls preload="none" poster="https://walkingyog.com/wp-content/uploads/2025/10/roothead.gif" style="display:none;max-width:460px;margin:18px auto;border-radius:12px;">
      <source src="https://walkingyog.com/wp-content/uploads/2025/10/10066.mp4" type="video/mp4">
      Ваш браузер не поддерживает видео.
    </video>

  </div>

  <?php
  // Показ миниатюр записей travel
  $q = new WP_Query(['post_type'=>'post','category_name'=>'traveling','posts_per_page'=>6]);
  if ($q->have_posts()): ?>
    <div style="margin-top:28px;text-align:center"><h2>Путешествуем в</h2></div>
    <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-top:12px">
      <?php while($q->have_posts()): $q->the_post(); ?>
        <div style="width:260px">
          <a href="<?php the_permalink(); ?>">
            <?php if (has_post_thumbnail()) the_post_thumbnail('medium', ['style'=>'border-radius:12px;width:100%']); ?>
            <h3 style="color:#fff;margin:8px 0 0;"><?php the_title(); ?></h3>
          </a>
        </div>
      <?php endwhile; wp_reset_postdata(); ?>
