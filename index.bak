<script>
(function(){
  const DELAY = 116500; // 120 - 4 сек (как ты хотел)
  const a = document.createElement('a');

  a.id = 'donation-box';
  a.href = '/donatik';

  const img = document.createElement('img');
  img.src = 'https://walkingyog.com/wp-content/uploads/2025/12/Стеклянная-донатная-коробка_1.png';

  const vid = document.createElement('video');
  vid.src = 'https://walkingyog.com/wp-content/uploads/2025/12/video-6.mp4';
  vid.muted = true;
  vid.loop = true;
  vid.playsInline = true;
  vid.style.display = 'none';

  a.appendChild(img);
  a.appendChild(vid);
  document.body.appendChild(a);

  setTimeout(() => {
    a.classList.add('show');
  }, DELAY);

  a.addEventListener('mouseenter', () => {
    img.style.display = 'none';
    vid.style.display = 'block';
    vid.play().catch(()=>{});
  });

  a.addEventListener('mouseleave', () => {
    vid.pause();
    vid.currentTime = 0;
    vid.style.display = 'none';
    img.style.display = 'block';
  });

})();
</script>



